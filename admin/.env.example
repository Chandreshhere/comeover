# Copy to .env.local and fill in. All values are required — the console shows a
# "Configuration required" page if any is missing. NEXT_PUBLIC_* values are
# inlined at build time: rebuild after changing them.

# Backend HttpApiUrl output (already includes /v1)
NEXT_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com/v1

# Cognito Hosted UI for the admin app client (public client, code + PKCE, no secret)
NEXT_PUBLIC_COGNITO_DOMAIN=https://your-domain.auth.ap-south-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Must exactly match an "Allowed callback URL" on the app client
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3001/auth/callback
# Must exactly match an "Allowed sign-out URL" on the app client
NEXT_PUBLIC_COGNITO_LOGOUT_URI=http://localhost:3001/login?signedout=1
