# Copy to .env.local and fill in. The console shows a "Configuration required"
# page if the value is missing. NEXT_PUBLIC_* values are inlined at build time:
# rebuild after changing them.

# Project IRL API base URL (includes /v1). Add this console's origin to the
# API's CORS_ORIGINS. Sign-in is phone OTP via the API (Slide); grant roles with
# `npm run grant-role -- <phone> admin|moderator` in backend/.
NEXT_PUBLIC_API_URL=http://localhost:8080/v1
