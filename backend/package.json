{
  "name": "irl-backend",
  "version": "0.2.0",
  "private": true,
  "description": "Project IRL API — Node.js (Express) + MongoDB, Slide OTP auth, WebSocket realtime, Docker",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "check": "node scripts/check.js",
    "seed": "node scripts/seed.js",
    "grant-role": "node scripts/grant-role.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.2"
  }
}
