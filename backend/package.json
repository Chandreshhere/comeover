{
  "name": "irl-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Project IRL API — AWS SAM (API Gateway HTTP + WebSocket, Lambda, Cognito, RDS PostgreSQL/PostGIS, S3, SQS)",
  "type": "commonjs",
  "main": "src/handlers/profile.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "check": "node scripts/check.js",
    "migrate": "node scripts/migrate.js",
    "template": "node scripts/build-template.js",
    "db:up": "docker compose up -d db",
    "build": "sam build",
    "deploy": "sam deploy --guided"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.700.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/s3-presigned-post": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "aws-jwt-verify": "^4.0.1",
    "pg": "^8.13.1"
  }
}
