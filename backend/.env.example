# ---------------------------------------------------------------------------
# Project IRL API — environment (copy to .env). Never commit real values.
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
# Public URL of this API (used in links, e.g. data exports). WS lives at wss://<host>/ws
PUBLIC_BASE_URL=https://api.example.com
# Comma-separated browser origins allowed by CORS (the admin console). Mobile apps don't need CORS.
CORS_ORIGINS=https://admin.example.com
# Express "trust proxy" (set to the number of proxies / CIDRs in front of the app)
TRUST_PROXY=loopback, linklocal, uniquelocal
# Return 503 { code: 'maintenance' } for app routes (admin, auth and webhooks stay up)
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=

# --- MongoDB (must be a replica set: Atlas, or rs0 from docker-compose) -----
MONGODB_URI=mongodb://localhost:27017/irl?replicaSet=rs0
MONGO_POOL_MAX=20

# --- Auth --------------------------------------------------------------------
# HS256 secret for access tokens (≥32 random chars): openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=projectirl
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# Slide OTP (https://slide.synquic.com → Dashboard → OTP). Server-side only.
SLIDE_BASE_URL=https://api.slide.cx
SLIDE_API_KEY=sk_live_xxx
SLIDE_OTP_WIDGET_ID=wgt_xxx
SLIDE_TIMEOUT_MS=10000
# Slide SMS for trusted-contact plan shares (POST /v1/sms/send). India: DLT-approved
# sender ID + templates; the message text must match the template. Leave empty to skip SMS
# (the app still offers a native share sheet; responses report smsSent=false).
SLIDE_SMS_SENDER_ID=
SLIDE_SMS_TEMPLATE_PLAN_SHARE=
SLIDE_SMS_TEMPLATE_TRUSTED_INVITE=
# Optional: moderation alerts (urgent/high reports, appeals) also POST { text } here (e.g. Slack incoming webhook).
MODERATION_WEBHOOK_URL=
# Number of digits in the code (match the Slide OTP widget); the apps size their code boxes from this.
SLIDE_OTP_CODE_LENGTH=6
# --- TEMPORARY test login (leave empty in real use) --------------------------------
# Fixed code for ONE phone number so you can test before Slide is configured.
# Anyone who knows the number + code can sign in as that user (incl. admin) — keep it short-lived.
# In production it is ignored unless TEST_LOGIN_ALLOW_PRODUCTION=true AND TEST_LOGIN_EXPIRES_AT is a future ISO date.
TEST_LOGIN_PHONE=
TEST_LOGIN_CODE=
TEST_LOGIN_EXPIRES_AT=
TEST_LOGIN_ALLOW_PRODUCTION=false
OTP_TTL_SEC=600
OTP_RESEND_AFTER_SEC=30
OTP_MAX_ATTEMPTS=5

# --- Media (S3-compatible: AWS S3, Cloudflare R2, MinIO) ----------------------
S3_BUCKET=
S3_REGION=ap-south-1
# R2: https://<account>.r2.cloudflarestorage.com  ·  MinIO: http://minio:9000 (+ S3_FORCE_PATH_STYLE=true)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Leave empty to use the default AWS credential chain (instance/task role)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# AES256 (AWS default) | none (e.g. R2)
S3_SSE=AES256
# Optional CDN in front of the bucket for public avatar URLs; otherwise short-lived signed URLs
MEDIA_CDN_URL=

# --- IRL Guide (Claude API) --------------------------------------------------
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

# --- Business invoices (Razorpay — Venue/Club plan only; no wallet/custody) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VENUE_PLAN_PRICE_INR=999

# --- Store billing --------------------------------------------------------------
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# p8 private key on one line with \n escapes
APPLE_IAP_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.projectirl.app
APPLE_ENV=Sandbox
APPLE_ROOT_CA_G3_SHA256=
ANDROID_PACKAGE_NAME=com.projectirl.app
GOOGLE_RTDN_TOKEN=
IAP_PLUS_PRODUCT_ID=irl_plus_monthly
IAP_PRO_PRODUCT_ID=irl_pro_monthly

# --- Google service account (Play Developer API + FCM push), JSON on one line ---
GOOGLE_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# --- Workers ---------------------------------------------------------------------
# Disable on extra replicas if you want a dedicated worker; cron slots are de-duplicated anyway.
JOBS_ENABLED=true
JOBS_POLL_MS=2000
REALTIME_CHANGE_STREAMS=true

# Optional remote-config override of the plan feature matrix (JSON {feature: tier})
PLAN_MATRIX_JSON=
