# Local development (sam local / node scripts). In AWS these come from template.yaml.
AWS_REGION=ap-south-1
STAGE=dev

# Database: local docker (docker compose up -d db) or the RDS Proxy via DB_SECRET_ARN
DATABASE_URL=postgres://irl:irl@localhost:5432/irl
DB_SSL=false
# DB_PROXY_ENDPOINT=irl-proxy.proxy-xxxx.ap-south-1.rds.amazonaws.com
# DB_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789012:secret:rds!db-xxxx
DB_NAME=irl

# Cognito (stack outputs)
USER_POOL_ID=
USER_POOL_CLIENT_ID=

# Media / realtime / jobs (stack outputs; leave empty to skip locally)
MEDIA_BUCKET=
MEDIA_CDN_URL=
WS_ENDPOINT=
JOBS_QUEUE_URL=
MODERATION_TOPIC_ARN=

# IRL Guide (Claude API). Prefer ANTHROPIC_SECRET_ARN (irl/anthropic → {"apiKey":"..."}) in AWS.
ANTHROPIC_API_KEY=
ANTHROPIC_SECRET_ARN=
ASSISTANT_MODEL=claude-opus-5-5

# Business invoices (Razorpay — Venue/Club plan only; no wallet/custody)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SECRET_ARN=
VENUE_PLAN_PRICE_INR=999

# Store billing
APPLE_IAP_SECRET_ARN=
APPLE_BUNDLE_ID=com.projectirl.app
APPLE_ENV=Sandbox
APPLE_ROOT_CA_G3_SHA256=
ANDROID_PACKAGE_NAME=com.projectirl.app
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_SECRET_ARN=
GOOGLE_RTDN_TOKEN=
IAP_PLUS_PRODUCT_ID=irl_plus_monthly
IAP_PRO_PRODUCT_ID=irl_pro_monthly

# SMS (SNS) — India DLT registration is required for +91 delivery
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_ID=

# Optional remote-config override of the plan feature matrix (JSON {feature: tier})
PLAN_MATRIX_JSON=
